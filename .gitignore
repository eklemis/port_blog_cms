# Rust build output. Matches the root workspace target/ and any stale
# per-crate target/ dirs left over from before the workspace was hoisted.
target/

# Cargo.lock IS committed. These are deployable binaries, and both
# Dockerfiles copy the lockfile so a Cloud Build produces the same
# dependency graph as a local build.

/media-status-updater/node_modules/
node_modules/

*.env
*.env.test
*.npmrc
*.envrc
.envrc

# graphify knowledge graph — regenerated from source, ~30s at zero API cost via
# `graphify extract . --code-only --no-cluster && graphify cluster-only . --no-label`.
# cache/, graph.json and graph.html alone are ~16MB of churn-heavy generated data.
graphify-out/

# coverage output
/backend_actix/tarpaulin-report.*
/backend_actix/lcov.info

.DS_Store
