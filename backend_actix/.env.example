# backend_actix — configuration template
#
# Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.
#
# HOW LOADING WORKS
#   On startup the process reads RUST_ENV (default: "development"), then tries
#   `.env.<RUST_ENV>` and falls back to `.env` if that file does not exist.
#   So `RUST_ENV=test` loads `.env.test`, and anything else loads `.env`.
#   Variables already present in the real environment always win — this is how
#   Cloud Run injects secrets, where no .env file exists at all.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the process panics on startup if any of these are missing
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Local default matches docker/postgres.compose.yml.
DATABASE_URL=postgres://developer:change-me-locally@localhost:5432/cms

# Redis connection string. Backs the refresh-token blacklist and the
# rate-limit counters. Use `rediss://` for a TLS endpoint.
# NOTE: the compose file does NOT provide Redis — see readme.md for how to
# start one locally.
REDIS_URL=redis://localhost:6379

# HS256 signing key for all four JWT kinds.
# MUST be at least 32 characters or startup panics. Generate one with:
#     openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# The From: address on verification and password-reset mail.
EMAIL_FROM=no-reply@example.com


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED unless RUST_ENV=test
#
# When RUST_ENV=test the process ignores these and talks to a local Mailpit
# instead (see SMTP_HOST / SMTP_PORT below). Otherwise all three must be set
# or startup panics.
# ─────────────────────────────────────────────────────────────────────────────

SMTP_SERVER=smtp.example.com
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace-me


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — shown with the default the code applies when unset
# ─────────────────────────────────────────────────────────────────────────────

# Selects which .env file is loaded, and switches three behaviours:
#   test        → SMTP goes to local Mailpit instead of a real server
#   production  → Argon2 hashes on a blocking thread; the `test-helpers`
#                 feature refuses to start
#   anything else (default "development")
RUST_ENV=development

# Bind address and port.
HOST=0.0.0.0
PORT=8080

# `iss` claim on issued tokens.
JWT_ISSUER=Ekstion

# Token lifetimes, in seconds. Validated at startup:
#   JWT_ACCESS_EXPIRY must be 1..=86400
#   JWT_REFRESH_EXPIRY must be greater than JWT_ACCESS_EXPIRY
JWT_ACCESS_EXPIRY=1800
JWT_REFRESH_EXPIRY=604800
JWT_VERIFICATION_EXPIRY=86400
# Deliberately shorter than verification: a reset link is a live credential
# for the account.
JWT_PASSWORD_RESET_EXPIRY=3600

# Frontend routes the emailed links point at. The token is appended as a
# path segment.
VERIFICATION_HANDLER_URL=0.0.0.0:5173/email/verification
PASSWORD_RESET_HANDLER_URL=0.0.0.0:5173/password-reset

# Comma-separated browser origins allowed to call the API.
# SET THIS IN PRODUCTION. When unset the server logs a warning and falls back
# to http://localhost:5173,http://127.0.0.1:5173 — development only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GCS bucket that receives media uploads.
MULTIMEDIA_UPLOAD_BUCKET=blogport-cms-upload

# Local Mailpit, used ONLY when RUST_ENV=test.
SMTP_HOST=localhost
SMTP_PORT=1025


# ─────────────────────────────────────────────────────────────────────────────
# NOT SET HERE
# ─────────────────────────────────────────────────────────────────────────────
#
# GOOGLE_APPLICATION_CREDENTIALS
#   Path to a service-account JSON key. Required for the media endpoints:
#   signed upload/read URLs cannot be produced from `authorized_user`
#   credentials, so `gcloud auth application-default login` is not enough.
#   Export it in your shell rather than putting a key path in .env.
#   Every other endpoint works without it.
#
# ARGON2_MEMORY_KIB / ARGON2_ITERATIONS / ARGON2_PARALLELISM / USE_BLOCKING_HASH
#   Read by `Argon2Hasher::from_env()`, which the running binary does not call —
#   main.rs selects `budget_vps()` or `fast_env()` from RUST_ENV instead.
#   Setting them currently has no effect. They appear in `.env.test` for
#   historical reasons.
#
# SKIP_REDIS_TESTS, TEST_JWT_SECRET, TEST_ACCESS_TOKEN, TEST_REFRESH_TOKEN
#   Test-suite only; see the "Running the tests" section of readme.md.
