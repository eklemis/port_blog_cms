# Copy to `docker/.env` — Compose resolves `env_file` relative to the compose
# file, not to the directory you run the command from.
#
#     cp docker/.env.example docker/.env
#
# These initialise the Postgres container. The application's own DATABASE_URL
# lives in backend_actix/.env and must use the same user, password and
# database name.

POSTGRES_DB=cms
POSTGRES_USER=developer
POSTGRES_PASSWORD=change-me-locally

# Read by the compose file only for readability; the postgres image itself
# defaults to 5432 and binds it in postgres.compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Generations one person may make per calendar month.
#
# UNSET MEANS UNMETERED — and unmetered still counts. `GET /api/ai/quota`
# reports `used` either way and `limit: null` when this is unset, so a ceiling
# can later be chosen from real usage rather than guessed, and the screens that
# display it are built before they are needed.
#
# A value that is not a number is treated as unmetered and logged, rather than
# as zero: a typo here must not silently refuse every generation.
# AI_MONTHLY_QUOTA=200
